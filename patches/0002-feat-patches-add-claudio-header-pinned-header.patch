+import fs from 'node:fs';
+import path from 'node:path';
+import { describe, it, expect } from 'vitest';
+
+import {
+  writeClaudioHeader,
+  CLAUDIO_HEADER_ROWS,
+  CLAUDIO_HEADER_REQUEST_ID,
+} from './claudioHeader';
+import { applyPatchImplementationsToGraph } from './nativeGraphDispatcher';
+import { PatchGroup } from './index';
+
+// Shapes copied from Claude Code 2.1.330.
+const layout =
+  'function jbn(m){let le=k(155),{scrollable:h,sidebar:w,sidebarWidth:T,dock:x,dockWidth:_,dockTail:C,top:L,header:W,abovePrompt:j,bottom:V}=m,' +
+  'ze=T===void 0?0:T,ce=qe(),{rows:pe,columns:Qe}=ce,Ht=W!=null&&pe>=n7n,Ee=pe-(Ht?w2s:0),st;' +
+  'let Fo=W!=null&&e(g,{flexShrink:0,width:"100%",children:W});return o(Di,{children:[Fo,h,V]})}';
+
+const repl =
+  'import{uu}from"/$bunfs/root/chunk-t7wkkwx8.js";' +
+  'function nP(h){let V=k(5);const je=uu.useRenderInput("SessionMode",z,se);return uu.useRenderHook(je,Ge)}' +
+  'function Ux(h){let Ln=k(800),_L;' +
+  '_L=e(jbn,{scrollViewport:vl.viewport,modal:bv,modalScrollViewport:vl.modalViewport,unseen:vl,hidePill:BS,askBelow:mc,' +
+  'hideSticky:qu.isTeammate,isDialogAbovePrompt:vv,onLinkNotOpened:US,header:void 0,top:null,sidebar:lq,sidebarWidth:LS,' +
+  'dock:_v,dockWidth:_w,dockTail:xx,transcriptOverlay:DE,scrollable:NE,abovePrompt:xw,bottom:CL});return _L}\n' +
+  'export{Ux,nP};';
+
+describe('claudioHeader', () => {
+  it('reserves the rows the REPL asks for in the layout', () => {
+    const result = writeClaudioHeader(layout) as string;
+    expect(result).toContain(
+      'Ht=W!=null&&pe>=n7n,Ee=pe-(Ht?(m.claudioHeaderRows??w2s):0),st;'
+    );
+    expect(() => new Function(result)).not.toThrow();
+  });
+
+  it('fills the REPL header slot with the mod-drawn header', () => {
+    const result = writeClaudioHeader(repl) as string;
+    expect(result).toContain(
+      `header:e(__ClaudioHeader,{}),claudioHeaderRows:${CLAUDIO_HEADER_ROWS},top:null,sidebar:lq,`
+    );
+    expect(result).toContain(
+      `requestId:"${CLAUDIO_HEADER_REQUEST_ID}",props:{id:"header",plugin:"claudio"}`
+    );
+    expect(result).toContain(
+      'uu.useRenderHook(uu.useRenderInput("Placed",__claudioHeaderInput,[]),__claudioHeaderNone)'
+    );
+    // Helpers at module scope, before the closing export.
+    expect(result.indexOf('function __ClaudioHeader(')).toBeLessThan(
+      result.lastIndexOf('export{')
+    );
+    expect(result.indexOf('function __ClaudioHeader(')).toBeGreaterThan(
+      result.indexOf('return _L}')
+    );
+  });
+
+  it('returns null for a module that has neither', () => {
+    expect(writeClaudioHeader('function x(){return 1}')).toBeNull();
+  });
+
+  it('leaves an already patched module alone', () => {
+    const once = writeClaudioHeader(repl) as string;
+    expect(writeClaudioHeader(once)).toBe(once);
+    const laid = writeClaudioHeader(layout) as string;
+    expect(writeClaudioHeader(laid)).toBe(laid);
+  });
+
+  // The real 2.1.330 modules, when extracted next to the test run:
+  // CLAUDIO_HEADER_MODULES=<dir with mod-layout.mjs and mod-repl.mjs>.
+  const dir = process.env.CLAUDIO_HEADER_MODULES;
+  it.skipIf(!dir)('patches the real layout and REPL modules', () => {
+    const read = (f: string) => fs.readFileSync(path.join(dir!, f), 'latin1');
+    const sources = new Map([
+      ['/$bunfs/root/chunk-layout.js', read('mod-layout.mjs')],
+      ['/$bunfs/root/chunk-repl.js', read('mod-repl.mjs')],
+    ]);
+    const { results } = applyPatchImplementationsToGraph(
+      sources,
+      { 'claudio-header': { fn: writeClaudioHeader, condition: true } },
+      [
+        {
+          id: 'claudio-header',
+          name: 'Claudio pinned header',
+          group: PatchGroup.MISC_CONFIGURABLE,
+          description: 'test',
+        },
+      ]
+    );
+    expect(results[0].details).toBe('Updated 2 module(s).');
+    for (const [name, source] of sources)
+      fs.writeFileSync(
+        path.join(dir!, `patched-${path.basename(name, '.js')}.mjs`),
+        source,
+        'latin1'
+      );
+  });
+});
