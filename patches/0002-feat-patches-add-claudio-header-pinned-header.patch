+++ b/src/patches/claudioHeader.ts
@@ -0,0 +1,114 @@
+// Please see the note about writing patches in ./index
+
+/**
+ * Claudio (the `claudio` launcher's own copy of Claude Code): a header pinned
+ * above the transcript in the fullscreen layout, drawn by the Claudio mod.
+ *
+ * The fullscreen layout already has a header slot: a full-width row above the
+ * transcript, the dock and the prompt, which never scrolls, shown from 15
+ * terminal rows. The REPL leaves it empty (`header:void 0`). Two modules
+ * change, each recognised by its own code, so the result reads "Updated 2
+ * module(s)":
+ *
+ * - The REPL fills the slot with `__ClaudioHeader`, which asks the plugins'
+ *   `ui.render` hooks for a `Placed` drawing (plugin "claudio", id "header",
+ *   requestId "claudio-header") the way a `$.ui.place` row is asked. The mod's
+ *   hook draws it; with no answer the slot stays blank.
+ * - The layout takes the slot's rows from what the rest of the screen gets.
+ *   Stock takes 2; the REPL now passes `claudioHeaderRows`, the height the mod
+ *   draws (CLAUDIO_HEADER_ROWS), so the transcript and the prompt are sized to
+ *   the rows really left.
+ */
+
+export const CLAUDIO_HEADER_ROWS = 5;
+export const CLAUDIO_HEADER_REQUEST_ID = 'claudio-header';
+
+const ID = '[$\\w]+';
+const esc = (name: string): string => name.replace(/\$/g, '\\$');
+
+/**
+ * The fullscreen layout (`function jbn(m){let le=k(155),{scrollable,…,
+ * header:W,…}=m,…,Ht=W!=null&&pe>=n7n,Ee=pe-(Ht?w2s:0)`): reserve the rows
+ * the REPL asks for instead of the stock 2.
+ */
+const patchLayout = (file: string): string | null => {
+  const head = file.match(
+    new RegExp(
+      `function ${ID}\\((${ID})\\)\\{let ${ID}=${ID}\\(\\d+\\),\\{scrollable:${ID},[^}]*?header:(${ID}),[^}]*\\}=\\1,`
+    )
+  );
+  if (!head || head.index === undefined) return null;
+  const [, props, header] = head;
+
+  const reserve = file
+    .slice(head.index)
+    .match(
+      new RegExp(
+        `(${ID})=${esc(header)}!=null&&(${ID})>=(${ID}),(${ID})=\\2-\\(\\1\\?(${ID}):0\\)`
+      )
+    );
+  if (!reserve || reserve.index === undefined || reserve.index > 3000)
+    return null;
+  const [text, shown, rows, min, left, stock] = reserve;
+
+  const at = head.index + reserve.index;
+  const replacement =
+    `${shown}=${header}!=null&&${rows}>=${min},` +
+    `${left}=${rows}-(${shown}?(${props}.claudioHeaderRows??${stock}):0)`;
+  return file.slice(0, at) + replacement + file.slice(at + text.length);
+};
+
+/**
+ * The REPL's fullscreen branch (`e(jbn,{scrollViewport:…,header:void 0,
+ * top:null,…})`): put the mod-drawn header in the slot.
+ */
+const patchRepl = (file: string): string | null => {
+  const call = file.match(
+    new RegExp(
+      `(${ID})\\(${ID},\\{scrollViewport:[^{}]*?header:void 0,top:null,`
+    )
+  );
+  if (!call || call.index === undefined) return null;
+  const jsx = call[1];
+
+  // The render-hook helpers the module draws plugin sites with
+  // (`uu.useRenderHook(uu.useRenderInput("SessionMode",…),…)`).
+  const hooks = file.match(new RegExp(`(${ID})\\.useRenderHook\\(`))?.[1];
+  if (!hooks || !file.includes(`${hooks}.useRenderInput(`)) return null;
+
+  // Module scope, so the helpers sit before the closing export.
+  const exportAt = file.lastIndexOf('export{');
+  if (exportAt < call.index) return null;
+
+  const newCall = call[0].replace(
+    'header:void 0,top:null,',
+    `header:${jsx}(__ClaudioHeader,{}),claudioHeaderRows:${CLAUDIO_HEADER_ROWS},top:null,`
+  );
+  const helper =
+    `function __claudioHeaderInput(){return{requestId:"${CLAUDIO_HEADER_REQUEST_ID}",props:{id:"header",plugin:"claudio"}}}` +
+    `function __claudioHeaderNone(){return null}` +
+    `function __ClaudioHeader(){return ${hooks}.useRenderHook(${hooks}.useRenderInput("Placed",__claudioHeaderInput,[]),__claudioHeaderNone)}`;
+
+  const callEnd = call.index + call[0].length;
+  return (
+    file.slice(0, call.index) +
+    newCall +
+    file.slice(callEnd, exportAt) +
+    helper +
+    file.slice(exportAt)
+  );
+};
+
+export const writeClaudioHeader = (oldFile: string): string | null => {
+  if (
+    oldFile.includes('__ClaudioHeader(') ||
+    oldFile.includes('.claudioHeaderRows??')
+  )
+    return oldFile;
+  // A module holds the layout, the REPL, or neither (then null: skipped).
+  const laid = patchLayout(oldFile);
+  const file = laid ?? oldFile;
+  const filled = patchRepl(file);
+  if (filled) return filled;
+  return laid;
+};
