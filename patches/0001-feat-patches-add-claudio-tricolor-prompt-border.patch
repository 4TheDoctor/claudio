+import fs from 'node:fs';
+import path from 'node:path';
+import { afterEach, describe, it, expect } from 'vitest';
+
+import { writeClaudioTricolor, CLAUDIO_COLORS } from './claudioTricolor';
+import {
+  beginGraphContext,
+  endGraphContext,
+  enterGraphModule,
+  leaveGraphModule,
+} from './graphContext';
+import { applyPatchImplementationsToGraph } from './nativeGraphDispatcher';
+import { PatchGroup } from './index';
+
+// Shapes copied from Claude Code 2.1.330.
+const painter =
+  'function PM(h,v,T,M=0,O){v=o$e(v);let L=oe(v),F=h.length;return[h,v,""]}' +
+  'function fc(h,v,T){let M=Yot(h,v);if(T)M=Re.dim(M);return M}' +
+  'var LM=(h,v,T,M,O)=>{let L=wTo(T.style.borderStyle);if(L!==void 0){let F=Math.floor(T.yogaNode.getComputedWidth()),' +
+  'Y=T.style.borderTopColor??T.style.borderColor,te=T.style.borderTopDimColor??T.style.borderDimColor,' +
+  'ae=T.style.borderTop!==!1,ue=T.style.borderLeft!==!1,he=T.style.borderRight!==!1,ge=Math.max(0,F-(ue?1:0)-(he?1:0)),' +
+  'ce=ae?(ue?L.topLeft:"")+L.top.repeat(ge)+(he?L.topRight:""):"",me;if(ae&&T.style.borderText){let[Le,ze,Ae]=PM(ce,T.style.borderText.content,T.style.borderText.align,T.style.borderText.offset,L.top);me=fc(Le,Y,te)+ze+fc(Ae,Y,te)}else if(ae)me=fc(ce,Y,te);' +
+  'if(me)M.write(h,v,me)}},mc=LM;';
+
+const prompt =
+  'function Cmt(h){let Er=k(601),{ref:T,draft:L,transcript:V,scope:z,turn:se,chrome:je}=h,Fo=$e(L,K_),vn=$e(L,vP),is=Xe();' +
+  'let qb=jpt(vn,is),iF="",Lo=void 0,Xx=void 0;' +
+  'let Qu=iF!==""&&e(g,{...qb,borderBottom:!1,width:oe(iF)+6,borderText:kee(iF)});' +
+  'let JE=e(g,{...qb,borderBottom:!1,flexGrow:1,borderText:Lo});' +
+  'let T_=e(g,{...qb,borderBottom:!1,width:"100%",borderText:Xx?kee(Xx):void 0});' +
+  'return o(ae,{children:[Qu,JE,T_]})}';
+
+const react =
+  'var I=function(t){return s.H.useRef(t)},y=function(t){return s.H.useState(t)},H=function(t,e){return s.H.useEffect(t,e)},' +
+  'Wc=function(t,e,n){var r,i={},a=null;if(e!=null)for(r in e)i[r]=e[r];return{type:t,props:i}};export{I,y,H,Wc};';
+
+describe('claudioTricolor', () => {
+  afterEach(() => {
+    leaveGraphModule();
+    endGraphContext();
+  });
+
+  const inGraph = (name: string, modules: Record<string, string>) => {
+    beginGraphContext(new Map(Object.entries(modules)));
+    enterGraphModule(name);
+    return writeClaudioTricolor(modules[name]);
+  };
+
+  it('splits the top border into flag runs when the box asks for it', () => {
+    const result = writeClaudioTricolor(painter) as string;
+    expect(result).toContain('function __claudioTri(s,x,p,w)');
+    expect(result).toContain(JSON.stringify(CLAUDIO_COLORS));
+    expect(result).toContain('o+=Yot(r,C[c])');
+    expect(result).toContain(
+      'else if(ae)me=T.style.claudioPhase!==void 0?__claudioTri(ce,h,T.style.claudioPhase,M.width):fc(ce,Y,te);'
+    );
+    expect(result).toContain(
+      '__claudioTri(Ae,h+Le.length+oe(ze),T.style.claudioPhase,M.width)'
+    );
+    expect(() => new Function(result)).not.toThrow();
+  });
+
+  it('paints runs by screen column and shifts them with the phase', () => {
+    const painted = writeClaudioTricolor(painter) as string;
+    const helper = painted.slice(
+      painted.indexOf('function __claudioTri'),
+      painted.indexOf('var LM=')
+    );
+    const tri = new Function(
+      'Yot',
+      `${helper};return __claudioTri;`
+    )((s: string, c: string) => `[${c}:${s.length}]`) as (
+      s: string,
+      x: number,
+      p: number,
+      w: number
+    ) => string;
+    const line = '─'.repeat(9);
+    expect(tri(line, 0, 0, 9)).toBe(
+      `[${CLAUDIO_COLORS[0]}:3][${CLAUDIO_COLORS[1]}:3][${CLAUDIO_COLORS[2]}:3]`
+    );
+    expect(tri(line, 0, 3, 9)).toBe(
+      `[${CLAUDIO_COLORS[2]}:3][${CLAUDIO_COLORS[0]}:3][${CLAUDIO_COLORS[1]}:3]`
+    );
+  });
+
+  it('routes the prompt rule boxes through the ticking wrapper', () => {
+    const result = inGraph('/$bunfs/root/chunk-prompt.js', {
+      '/$bunfs/root/chunk-prompt.js': prompt,
+      '/$bunfs/root/chunk-react.js': react,
+    }) as string;
+    expect(
+      result.match(
+        /e\(__ClaudioRule,\{claudioTurn:se,claudioBox:g,\.\.\.qb,borderBottom:!1,/g
+      )
+    ).toHaveLength(3);
+    expect(result).toContain('l=$e(t,__claudioLoading)');
+    expect(result).toContain('b.borderColor==="promptBorder"');
+    expect(result).toContain('$tcc_React.useState(0)');
+    expect(result.indexOf('function __ClaudioRule(')).toBeLessThan(
+      result.indexOf('function Cmt(')
+    );
+  });
+
+  it('returns null for a module that has neither', () => {
+    expect(writeClaudioTricolor('function x(){return 1}')).toBeNull();
+  });
+
+  it('leaves an already patched module alone', () => {
+    const once = writeClaudioTricolor(painter) as string;
+    expect(writeClaudioTricolor(once)).toBe(once);
+  });
+
+  // The real 2.1.330 modules, when extracted next to the test run:
+  // CLAUDIO_MODULES=<dir with mod-ink.mjs, mod-prompt.mjs, mod-react.mjs>.
+  const dir = process.env.CLAUDIO_MODULES;
+  it.skipIf(!dir)('patches the real Ink and prompt modules', () => {
+    const read = (f: string) => fs.readFileSync(path.join(dir!, f), 'utf8');
+    const sources = new Map([
+      ['/$bunfs/root/chunk-ink.js', read('mod-ink.mjs')],
+      ['/$bunfs/root/chunk-prompt.js', read('mod-prompt.mjs')],
+      ['/$bunfs/root/chunk-react.js', read('mod-react.mjs')],
+    ]);
+    const { results } = applyPatchImplementationsToGraph(
+      sources,
+      { 'claudio-tricolor': { fn: writeClaudioTricolor, condition: true } },
+      [
+        {
+          id: 'claudio-tricolor',
+          name: 'Claudio tricolor prompt',
+          group: PatchGroup.MISC_CONFIGURABLE,
+          description: 'test',
+        },
+      ]
+    );
+    expect(results[0].details).toBe('Updated 2 module(s).');
+    for (const [name, source] of sources)
+      fs.writeFileSync(
+        path.join(dir!, `patched-${path.basename(name, '.js')}.mjs`),
+        source
+      );
+  });
+});
