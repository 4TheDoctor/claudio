+// Please see the note about writing patches in ./index
+
+import { getReactVar } from './helpers';
+
+/**
+ * Claudio (the `claudio` launcher's own copy of Claude Code): the prompt
+ * input's top and bottom rules in the Italian flag's green, white and red.
+ * They scroll sideways while a turn runs and stand still otherwise.
+ *
+ * Two modules change. Each is recognised by its own code, so one patch id
+ * covers both and the result reads "Updated 2 module(s)":
+ *
+ * - Ink's border painter. A box whose style carries `claudioPhase` gets its
+ *   top border split into three runs by screen column (each a third of the
+ *   screen), shifted right by the phase. Every other box paints as before.
+ * - The prompt input. Its rule boxes (`{...border,borderBottom:!1,...}`
+ *   with a `borderText`) are drawn through a wrapper that adds
+ *   `claudioPhase` to their style: 0 while idle, the wall clock in ticks
+ *   while the turn's `isLoading` is true, re-rendered on every tick.
+ *
+ * The tick is what moves it: Ink copies a box from the previous frame unless
+ * its node is dirty, and a changed style is what marks it dirty. Bash mode
+ * and agent-coloured borders keep their own colour (the wrapper only acts on
+ * `borderColor:"promptBorder"`).
+ */
+
+export const CLAUDIO_COLORS = ['#009246', '#F1F2F1', '#CE2B37'] as const;
+export const CLAUDIO_TICK_MS = 110;
+const COLUMNS_PER_TICK = 2;
+
+const ID = '[$\\w]+';
+const esc = (name: string): string => name.replace(/\$/g, '\\$');
+
+/**
+ * Ink's `renderBorder`: the top border is built as one string and coloured
+ * once (`me=fc(ce,Y,te)`). Split it into flag-coloured runs instead when the
+ * box asks for it.
+ */
+const patchBorderPainter = (file: string): string | null => {
+  const head = file.match(
+    new RegExp(
+      `var (${ID})=\\((${ID}),(${ID}),(${ID}),(${ID}),(${ID})\\)=>\\{let (${ID})=${ID}\\(\\4\\.style\\.borderStyle\\);`
+    )
+  );
+  if (!head || head.index === undefined) return null;
+  const [, , x, , node, out, , chars] = head;
+  const n = esc(node);
+  const c = esc(chars);
+
+  const topRe = new RegExp(
+    `(${ID})=(${ID})\\?\\((${ID})\\?${c}\\.topLeft:""\\)\\+${c}\\.top\\.repeat\\((${ID})\\)\\+\\((${ID})\\?${c}\\.topRight:""\\):"",(${ID});` +
+      `if\\(\\2&&${n}\\.style\\.borderText\\)\\{let\\[(${ID}),(${ID}),(${ID})\\]=(${ID})\\(\\1,${n}\\.style\\.borderText\\.content,${n}\\.style\\.borderText\\.align,${n}\\.style\\.borderText\\.offset,${c}\\.top\\);` +
+      `\\6=(${ID})\\(\\7,(${ID}),(${ID})\\)\\+\\8\\+\\11\\(\\9,\\12,\\13\\)\\}else if\\(\\2\\)\\6=\\11\\(\\1,\\12,\\13\\);`
+  );
+  const rest = file.slice(head.index);
+  const top = rest.match(topRe);
+  if (!top || top.index === undefined || top.index > 4000) return null;
+  const [topText, ce, ae, , , , me, left, text, right, splitFn, paint, color, dim] =
+    top;
+
+  // The colorizer `paint` wraps (`function fc(h,v,T){let M=Yot(h,v);…`) and
+  // the string-width helper the borderText splitter uses (`let L=oe(v)`).
+  const colorize = file.match(
+    new RegExp(
+      `function ${esc(paint)}\\((${ID}),(${ID}),${ID}\\)\\{let ${ID}=(${ID})\\(\\1,\\2\\);`
+    )
+  )?.[3];
+  const width = file.match(
+    new RegExp(
+      `function ${esc(splitFn)}\\(${ID},(${ID}),${ID},${ID}=0,${ID}\\)\\{\\1=${ID}\\(\\1\\);let ${ID}=(${ID})\\(\\1\\)`
+    )
+  )?.[2];
+  if (!colorize || !width) return null;
+
+  const phase = `${node}.style.claudioPhase`;
+  const tri = (s: string, col: string) =>
+    `__claudioTri(${s},${col},${phase},${out}.width)`;
+  const oldSplit = `${me}=${paint}(${left},${color},${dim})+${text}+${paint}(${right},${color},${dim})}`;
+  const newSplit =
+    `${me}=${phase}!==void 0?${tri(left, x)}+${text}+${tri(right, `${x}+${left}.length+${width}(${text})`)}` +
+    `:${paint}(${left},${color},${dim})+${text}+${paint}(${right},${color},${dim})}`;
+  const oldPlain = `else if(${ae})${me}=${paint}(${ce},${color},${dim});`;
+  const newPlain = `else if(${ae})${me}=${phase}!==void 0?${tri(ce, x)}:${paint}(${ce},${color},${dim});`;
+  if (!topText.includes(oldSplit) || !topText.endsWith(oldPlain)) return null;
+  const newTop = topText.replace(oldSplit, newSplit).replace(oldPlain, newPlain);
+
+  const helper =
+    `function __claudioTri(s,x,p,w){if(!s)return s;w=w>0?w:80;x=Math.floor(x);` +
+    `var C=${JSON.stringify(CLAUDIO_COLORS)},o="",r="",c=-1,i,k,b;` +
+    `for(i=0;i<s.length;i++){k=((x+i-p)%w+w)%w;b=Math.min(2,Math.floor(k*3/w));` +
+    `if(b!==c){if(r)o+=${colorize}(r,C[c]);r="";c=b}r+=s[i]}` +
+    `if(r)o+=${colorize}(r,C[c]);return o}`;
+
+  const topAt = head.index + top.index;
+  return (
+    file.slice(0, head.index) +
+    helper +
+    file.slice(head.index, topAt) +
+    newTop +
+    file.slice(topAt + topText.length)
+  );
+};
+
+/**
+ * The prompt input component (`function Cmt(h){let Er=k(601),{ref,draft,
+ * transcript,scope,turn,…}=h,Fo=$e(L,K_),…`): route its rule boxes through
+ * `__ClaudioRule`, which ticks while the turn is loading.
+ */
+const patchPromptRules = (file: string): string | null => {
+  const comp = file.match(
+    new RegExp(
+      `function (${ID})\\((${ID})\\)\\{let ${ID}=${ID}\\(\\d+\\),\\{ref:${ID},draft:(${ID}),transcript:${ID},scope:${ID},turn:(${ID}),`
+    )
+  );
+  if (!comp || comp.index === undefined) return null;
+  const [, , props, draft, turn] = comp;
+  const body = file.slice(comp.index);
+
+  // The store hook the component reads its draft with (`Fo=$e(L,K_)`).
+  const store = body.match(
+    new RegExp(`\\}=${esc(props)},${ID}=(${ID})\\(${esc(draft)},`)
+  )?.[1];
+  if (!store) return null;
+
+  // Rule boxes: `e(g,{...qb,borderBottom:!1,…,borderText:…})`, all spreading
+  // the same border style. Keep the first group found inside the component.
+  const ruleRe = new RegExp(
+    `(${ID})\\((${ID}),\\{\\.\\.\\.(${ID}),borderBottom:!1,(?=[^}]*borderText:)`,
+    'g'
+  );
+  const rules = [...body.matchAll(ruleRe)].filter(m => (m.index ?? 0) < 80000);
+  if (rules.length === 0) return null;
+  const [, jsx, box, border] = rules[0];
+  const group = rules.filter(
+    m => m[1] === jsx && m[2] === box && m[3] === border
+  );
+  if (group.length < 2) return null;
+
+  const react = getReactVar(file);
+  if (!react) return null;
+
+  let patchedBody = body;
+  for (const m of [...group].reverse()) {
+    const at = m.index!;
+    const replacement = `${jsx}(__ClaudioRule,{claudioTurn:${turn},claudioBox:${box},...${border},borderBottom:!1,`;
+    patchedBody =
+      patchedBody.slice(0, at) +
+      replacement +
+      patchedBody.slice(at + m[0].length);
+  }
+
+  const wrapper =
+    `function __claudioLoading(s){return!!(s&&s.isLoading)}` +
+    `function __ClaudioRule(p){let{claudioTurn:t,claudioBox:B,...b}=p,l=${store}(t,__claudioLoading),[,f]=${react}.useState(0);` +
+    `${react}.useEffect(()=>{if(!l)return;let i=setInterval(()=>f((n)=>n+1),${CLAUDIO_TICK_MS});return()=>clearInterval(i)},[l]);` +
+    `return ${jsx}(B,b.borderColor==="promptBorder"?{...b,claudioPhase:l?Math.floor(Date.now()/${CLAUDIO_TICK_MS})*${COLUMNS_PER_TICK}:0}:b)}`;
+
+  return file.slice(0, comp.index) + wrapper + patchedBody;
+};
+
+export const writeClaudioTricolor = (oldFile: string): string | null => {
+  if (oldFile.includes('__claudioTri(') || oldFile.includes('__ClaudioRule('))
+    return oldFile;
+  // A module holds the painter, the prompt, or neither (then null: skipped).
+  const painted = patchBorderPainter(oldFile);
+  const file = painted ?? oldFile;
+  const ruled = patchPromptRules(file);
+  if (ruled) return ruled;
+  return painted;
+};
